# CIP local development configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is git-ignored.

# --- Service ---
CIP_ENV=dev
CIP_SERVICE_NAME=reference-service
LOG_LEVEL=INFO

# --- Database (Postgres via docker-compose) ---
CIP_DATABASE_URL=postgresql+asyncpg://cip:cip@localhost:5432/cip

# --- Event bus (Redpanda via docker-compose) ---
CIP_KAFKA_BOOTSTRAP=localhost:9092

# --- Cache / idempotency store (Redis via docker-compose) ---
CIP_REDIS_URL=redis://localhost:6379/0

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=reference-service

# --- Secrets (dev only) ---
# In production these are pulled from a managed secret store, never env vars.
CIP_SECRET_PROVIDER=env
CIP_JWT_SIGNING_KEY=dev-only-placeholder-do-not-use-in-any-real-environment
